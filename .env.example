# Copy to .env (never commit .env). Every value is optional for local development.

# --- NASA FIRMS (real satellite data). Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=
# Live refresh button: seconds between two syncs of the same area, and whether visitors may press it (1) or operators only (0)
# FIRMS_LIVE_COOLDOWN_SECONDS=600
# FIRMS_LIVE_PUBLIC=1
# FIRMS_SYNC_INTERVAL_SECONDS=600     # cadence of `manage.py sync_scheduled --loop` (cron/Task Scheduler: schedule it every 10 min)

# --- IoT: device-to-server authentication for POST /iot/api/ingest/ (use a long random secret)
POLARIS_IOT_API_KEY=

# --- AI assistant (without a key it answers from the database)
GEMINI_API_KEY=
# Use API model codes, not dashboard display names. Verified against the official list on 2026-10-22:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Contact form e-mail (without these the message is still saved and shown in the admin)
# CONTACT_EMAIL=team@example.org
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=          # Gmail: use an App Password
# DEFAULT_FROM_EMAIL=

# --- Django. Local default is DEBUG on. For production set DEBUG=0, a private key (32+ chars) and the host list.
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.org,www.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org
# DJANGO_BEHIND_PROXY=1         # only if a reverse proxy terminates HTTPS
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
